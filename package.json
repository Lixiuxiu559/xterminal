{
  "name": "xterminal",
  "version": "0.1.1",
  "description": "本地执行、内网直连的开发会话工作空间",
  "author": "lixiuxiu",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test packages/core/src/*.test.ts packages/storage/src/*.test.ts packages/host/src/*.test.ts packages/engines/codex/src/*.test.ts packages/engines/claude/src/*.test.ts packages/engines/shared/src/*.test.ts apps/ui/src/*.test.ts",
    "test:storage": "python3 scripts/check-schema.py",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "rebuild:native": "electron-rebuild -f -w node-pty,better-sqlite3",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "package:mac": "pnpm build && electron-builder --mac dir",
    "smoke:codex-init": "node scripts/smoke-codex-init.mjs",
    "test:lan": "node --test packages/lan/src/*.test.ts",
    "smoke:codex-turn": "node scripts/smoke-codex-turn.mjs",
    "smoke:claude-turn": "node scripts/smoke-claude-turn.mjs",
    "smoke:agent-desktop": "node scripts/smoke-agent-desktop.mjs",
    "smoke:crash": "node scripts/smoke-crash.mjs",
    "smoke:crash-early-stop": "node scripts/smoke-crash-early-stop.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.304",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "13.0.3",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "dev.lixiuxiu.xterminal",
    "productName": "XTerminal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dir"
    }
  }
}
